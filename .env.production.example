# Copy to .env.production, restrict file permissions, and supply your real endpoints.
# Shell-compatible KEY=value format; quote special characters.
JWT_MODE=oidc
JWT_ISSUER=https://identity.example.com/realms/commerce
JWT_JWK_SET_URI=https://identity.example.com/realms/commerce/protocol/openid-connect/certs
JWT_AUDIENCE=commerce-api
CATALOG_DB_URL='jdbc:postgresql://catalog-db.example.com:5432/catalog?sslmode=verify-full'
CATALOG_DB_USER=catalog_app
CATALOG_DB_PASSWORD=REPLACE_ME
ORDER_DB_URL='jdbc:postgresql://order-db.example.com:5432/orders?sslmode=verify-full'
ORDER_DB_USER=orders_app
ORDER_DB_PASSWORD=REPLACE_ME
